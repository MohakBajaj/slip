{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/cli/**/*"
  ],
  "exclude": ["src/**/*.test.ts"],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "strictNullChecks": true,
    "types": ["electron-vite/node"]
  }
}
