{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ],
  "exclude": ["src/**/*.test.ts"],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    },
    "strictNullChecks": true
  }
}
