{
  "name": "slip",
  "version": "1.0.2",
  "description": "A local capture inbox. Shift Shift, and it is a markdown file.",
  "homepage": "https://github.com/MohakBajaj/slip",
  "author": "Mohak Bajaj",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "build": "electron-vite build",
    "check": "ultracite check --type-aware",
    "fix": "ultracite fix --type-aware",
    "typecheck:node": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json && node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json",
    "test": "bun test src/shared src/vault.test.ts",
    "postinstall": "electron-builder install-app-deps",
    "make:tray": "xcrun swift scripts/make-tray-icons.swift resources/tray",
    "make:dock": "xcrun swift scripts/mask-dock-icon.swift resources/dock/light.png resources/dock/dark.png",
    "make:dmg": "xcrun swift scripts/make-dmg-background.swift build && tiffutil -cathidpicheck build/background.png build/background@2x.png -out build/background.tiff",
    "build:cli": "sh scripts/build-cli.sh",
    "package:mac": "electron-vite build && sh scripts/build-cli.sh && env -u ELECTRON_RUN_AS_NODE CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --publish never",
    "release:mac": "electron-vite build && sh scripts/build-cli.sh && env -u ELECTRON_RUN_AS_NODE CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@bunli/core": "^0.9.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.1.0",
    "gray-matter": "^4.0.3",
    "koffi": "^3.1.5",
    "lucide-react": "^1.31.0",
    "perfect-freehand": "^1.2.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "ultracite": "7.10.4",
    "vite": "^7.3.6"
  },
  "trustedDependencies": [
    "electron",
    "koffi"
  ]
}
